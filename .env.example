# ─── Vectrax Environment Variables ─────────────────────────────────
# Copy this file to .env and fill in your values.

# ─── AI Providers ──────────────────────────────────────────────────
OPENAI_API_KEY=
GEMINI_API_KEY=

# ─── Market Data (Modo Mercado Total) ─────────────────────────────
# Binance: NO requiere API key para datos de mercado públicos.
#          Solo lectura. Sin trading.

# CoinGecko Demo API (opcional, mejora rate limits):
#   Obtener en: https://www.coingecko.com/en/api/pricing
COINGECKO_API_KEY=

# Alpha Vantage (requerida para datos de bolsa/stocks):
#   Obtener gratis en: https://www.alphavantage.co/support/#api-key
#   Free tier: 25 requests/día
ALPHAVANTAGE_API_KEY=

# ─── Telegram ────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=

# ─── Ingreso de mensajes: long-poll (default) vs webhook (durable) ───
# USE_WEBHOOK=0 → long-poll: telegram_gateway corre como proceso aparte.
# USE_WEBHOOK=1 → webhook: Telegram hace POST a
#   {WEBHOOK_BASE_URL}/v1/webhook/telegram/{TELEGRAM_WEBHOOK_SECRET}
#   servido por el core_api (:8900 detrás de nginx). Sin loop de poll, sin
#   los watchdogs del polling → elimina el heartbeat stale por construcción.
USE_WEBHOOK=0
# Secreto fuerte del webhook. Genera uno con:
#   python3 scripts/set_webhook.py --gen-secret
TELEGRAM_WEBHOOK_SECRET=
# Base URL pública HTTPS que nginx enruta al core_api :8900
WEBHOOK_BASE_URL=https://api.vectrax.app
