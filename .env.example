# ─── Vectrax Environment Variables ─────────────────────────────────
# Copy this file to .env and fill in your values. NEVER commit .env.

# ─── Core ──────────────────────────────────────────────────────────
VECTRAX_DB=
VECTRAX_EMBED_MODEL=

# ─── AI Providers ──────────────────────────────────────────────────
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# ─── Market Data (Modo Mercado Total) ─────────────────────────────
# Binance: NO requiere API key para datos de mercado públicos.
# Alpha Vantage (requerida para datos de bolsa/stocks):
#   Obtener gratis en: https://www.alphavantage.co/support/#api-key
ALPHAVANTAGE_API_KEY=
# CoinGecko Demo API (opcional, mejora rate limits):
#   Obtener en: https://www.coingecko.com/en/api/pricing
COINGECKO_API_KEY=

# ─── Google API — Places + búsqueda web ────────────────────────────
GOOGLE_PLACES_API_KEY=
# Google Custom Search (opcional — búsqueda web general)
# Crear CX en: https://programmablesearchengine.google.com/
# GOOGLE_CSE_CX=

# ─── Telegram ──────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_CREATOR_CHAT_ID=

# ─── Stripe (billing) ──────────────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=
STRIPE_TEAM_PRICE_ID=
STRIPE_WEBHOOK_SECRET=

# ─── Tavily — motor de búsqueda principal para IA ──────────────────
# Obtén tu clave en: https://app.tavily.com  (1000 búsquedas/mes gratis)
TAVILY_API_KEY=

# ─── Ingreso de mensajes: long-poll (default) vs webhook (durable) ──
# USE_WEBHOOK=0 → long-poll: telegram_gateway corre como proceso aparte.
# USE_WEBHOOK=1 → webhook: Telegram hace POST a
#   {WEBHOOK_BASE_URL}/v1/webhook/telegram/{TELEGRAM_WEBHOOK_SECRET}
USE_WEBHOOK=
# Secreto fuerte del webhook. Genera uno con:
#   python3 scripts/set_webhook.py --gen-secret
TELEGRAM_WEBHOOK_SECRET=
# Base URL pública HTTPS que nginx enruta al core_api :8900
WEBHOOK_BASE_URL=

# ─── Voz / audio ───────────────────────────────────────────────────
# 1 = desactiva cualquier respuesta de audio.
VECTRAX_AUDIO_DISABLED=

# ─── eToro (broker) ────────────────────────────────────────────────
ETORO_API_KEY=
ETORO_USER_KEY=
