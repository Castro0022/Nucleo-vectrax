# Vectrax — Production Environment
# IMPORTANT: Do NOT store real secrets here.
# Use your cloud provider's secrets manager (AWS SSM, GCP Secret Manager, etc.)

VX_ENV=production
VX_LOG_LEVEL=WARNING
VX_CORE_HOST=0.0.0.0
VX_CORE_PORT=8900
VX_RATE_LIMIT_RPM=60

# These MUST be provided via secrets manager at deploy time:
# VX_API_TOKEN=
# VX_JWT_SECRET=
# VX_DB_PATH=
# VX_VECTOR_DB_URL=
