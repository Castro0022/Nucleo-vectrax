{
  "domain": "sales_trends",
  "description": "Sales trends domain — transactional sales/returns/restock events. signature_fields keep star cardinality bounded so high-cardinality identifiers (invoice_id, customer_id) do not fragment stars; temporal structure across activations is handled generically by Gravity (core/learn/temporal_pattern.py), not by this template.",
  "event_types": {
    "sale": {
      "text_template": "Sale: {product} | category={category} | region={region} | qty={quantity} | amount=${amount}",
      "fields": ["product", "category", "region", "quantity", "amount", "invoice_id", "customer_id"],
      "signature_fields": ["category", "region"]
    },
    "return": {
      "text_template": "Return: {product} | category={category} | region={region} | reason={reason}",
      "fields": ["product", "category", "region", "reason", "invoice_id", "customer_id"],
      "signature_fields": ["category", "region", "reason"]
    },
    "restock": {
      "text_template": "Restock: {product} | category={category} | region={region} | qty={quantity}",
      "fields": ["product", "category", "region", "quantity", "supplier"],
      "signature_fields": ["category", "region"]
    },
    "price_change": {
      "text_template": "Price change: {product} | category={category} | ${old_price}→${new_price}",
      "fields": ["product", "category", "region", "old_price", "new_price"],
      "signature_fields": ["category", "region"]
    }
  }
}
