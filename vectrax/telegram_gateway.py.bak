"""
Vectrax — Telegram Gateway (Long Polling)
=============================================
Gateway que conecta un bot de Telegram al sistema Vectrax.
Los mensajes entran por long polling, se convierten en eventos internos
a través del ExternalGateway y el Universal Bus, y las respuestas se
envían de vuelta al usuario vía sendMessage.

Flujo:
  1. getUpdates (long polling) → mensaje de Telegram
  2. ExternalGateway.receive_message(user_id, content, "telegram")
  3. Bus emite telegram.message_received
  4. Sistema procesa → respuesta
  5. sendMessage → usuario de Telegram
  6. Todo queda registrado en ledger

Ejecución:
  python3 -m vectrax.telegram_gateway

Capa: External — Gateway de entrada (no accede al núcleo)
Creado: 2026-03-19
Creador: Mario Bravo Castro
"""

from __future__ import annotations

import logging
import os
import re
import signal
import sys
import time
import threading
from concurrent.futures import ThreadPoolExecutor
from pathlib import Path
from typing import Any, Dict, Optional

import httpx
from dotenv import load_dotenv

# ---------------------------------------------------------------------------
# Asegurar que el proyecto raíz es importable
# ---------------------------------------------------------------------------
_PROJECT_ROOT = Path(__file__).resolve().parent.parent
if str(_PROJECT_ROOT) not in sys.path:
    sys.path.insert(0, str(_PROJECT_ROOT))

from core.operator.external_gateway import ExternalGateway, get_external_gateway
from core.operator import ledger_bridge as ledger

# ---------------------------------------------------------------------------
# Logging
# ---------------------------------------------------------------------------

logging.basicConfig(
    level=logging.INFO,
    format="%(asctime)s [%(levelname)s] %(name)s — %(message)s",
    datefmt="%Y-%m-%d %H:%M:%S",
)
logger = logging.getLogger("vectrax.telegram_gateway")

# ---------------------------------------------------------------------------
# Constantes
# ---------------------------------------------------------------------------

TELEGRAM_API_BASE = "https://api.telegram.org/bot{token}"
POLL_TIMEOUT = 30          # segundos de long polling
RETRY_DELAY = 5            # segundos entre reintentos tras error
MAX_CONSECUTIVE_ERRORS = 10


# ---------------------------------------------------------------------------
# Telegram Gateway
# ---------------------------------------------------------------------------

class TelegramGateway:
    """
    Gateway de Telegram para Vectrax.

    Usa long polling (getUpdates) para recibir mensajes.
    Cada mensaje se enruta al ExternalGateway del bus universal.
    Las respuestas se envían con sendMessage.
    """

    def __init__(self, token: str) -> None:
        if not token:
            raise ValueError("TELEGRAM_BOT_TOKEN no puede estar vacío")
        self._token = token
        self._base_url = TELEGRAM_API_BASE.format(token=token)
        self._offset: int = 0
        self._running: bool = False
        self._gateway: ExternalGateway = get_external_gateway()
        self._poll_client: httpx.Client = httpx.Client(timeout=POLL_TIMEOUT + 10)
        self._send_client: httpx.Client = httpx.Client(timeout=40)
        self._send_lock = threading.Lock()
        self._consecutive_errors: int = 0
        self._total_processed: int = 0
        self._executor = ThreadPoolExecutor(max_workers=2, thread_name_prefix="tg_msg")
        logger.info("TelegramGateway initialized (threaded, 2 workers)")

    # -- API helpers --------------------------------------------------------

    def _api_call(self, method: str, **params: Any) -> Optional[Dict]:
        """Llama a un método de la Telegram Bot API (thread-safe con lock)."""
        url = f"{self._base_url}/{method}"
        try:
            with self._send_lock:
                resp = self._send_client.post(url, json=params)
            resp.raise_for_status()
            data = resp.json()
            if not data.get("ok"):
                logger.error("Telegram API error: %s", data.get("description", ""))
                return None
            return data.get("result")
        except httpx.HTTPStatusError as exc:
            logger.error("HTTP error calling %s: %s", method, exc)
            return None
        except httpx.RequestError as exc:
            logger.error("Request error calling %s: %s", method, exc)
            return None

    def _get_updates(self) -> list:
        """Obtiene actualizaciones pendientes vía long polling."""
        url = f"{self._base_url}/getUpdates"
        try:
            resp = self._poll_client.post(url, json={
                "offset": self._offset,
                "timeout": POLL_TIMEOUT,
                "allowed_updates": ["message"],
            })
            resp.raise_for_status()
            data = resp.json()
            if data.get("ok"):
                return data.get("result", [])
        except Exception as exc:
            logger.error("Polling error: %s", exc)
        return []

    def _send_message(self, chat_id: int, text: str, reply_markup: Optional[Dict] = None) -> bool:
        """Envía un mensaje de texto a un chat de Telegram."""
        # Telegram limita mensajes a 4096 caracteres
        if len(text) > 4096:
            text = text[:4093] + "..."
        params: Dict[str, Any] = {
            "chat_id": chat_id,
            "text": text,
        }
        if reply_markup:
            params["reply_markup"] = reply_markup
        result = self._api_call("sendMessage", **params)
        return result is not None

    def _request_location(self, chat_id: int) -> bool:
        """Envía un botón para que el usuario comparta su ubicación."""
        keyboard = {
            "keyboard": [[
                {"text": "📍 Compartir ubicación", "request_location": True},
            ]],
            "resize_keyboard": True,
            "one_time_keyboard": True,
        }
        return self._send_message(
            chat_id,
            "Para darte resultados cercanos, comparte tu ubicación:",
            reply_markup=keyboard,
        )

    def _send_venue(self, chat_id: int, place: Dict[str, Any]) -> bool:
        """Envía un lugar como venue de Telegram (abre el mapa directo)."""
        lat = place.get("lat", 0)
        lng = place.get("lng", 0)
        if not lat or not lng:
            return False

        title = place.get("nombre", "Lugar")
        address = place.get("direccion", "")

        # Agregar rating y distancia al título
        extras = []
        if place.get("rating"):
            extras.append(f"{place['rating']}★")
        if place.get("distancia_label"):
            extras.append(place["distancia_label"])
        if extras:
            title = f"{title} — {' — '.join(extras)}"

        result = self._api_call(
            "sendVenue",
            chat_id=chat_id,
            latitude=lat,
            longitude=lng,
            title=title,
            address=address or "Dirección no disponible",
        )
        return result is not None

    def _send_places_with_map(
        self, chat_id: int, places: list, max_venues: int = 3,
    ) -> bool:
        """Envía los mejores lugares como venues (mapa) + texto resumen."""
        sent = 0
        for place in places[:max_venues]:
            if self._send_venue(chat_id, place):
                sent += 1
        return sent > 0

    # -- Transcripción de voz ------------------------------------------------

    def _transcribe_voice(self, voice_data: Dict[str, Any]) -> Optional[str]:
        """
        Descarga un audio de Telegram y lo transcribe a texto.

        Flujo:
          1. getFile → obtener file_path del servidor de Telegram
          2. Descargar el archivo .ogg
          3. Transcribir con Whisper (local o API)
          4. Retornar texto o None
        """
        file_id = voice_data.get("file_id", "")
        if not file_id:
            return None

        try:
            # 1. Obtener URL del archivo
            file_info = self._api_call("getFile", file_id=file_id)
            if not file_info or "file_path" not in file_info:
                logger.warning("Could not get file info for %s", file_id)
                return None

            file_path = file_info["file_path"]
            download_url = f"https://api.telegram.org/file/bot{self._token}/{file_path}"

            # 2. Descargar el archivo
            import tempfile
            resp = self._client.get(download_url)
            resp.raise_for_status()

            # Guardar como .ogg temporal
            tmp_dir = os.path.join(tempfile.gettempdir(), "vectrax_voice")
            os.makedirs(tmp_dir, exist_ok=True)
            ogg_path = os.path.join(tmp_dir, f"tg_voice_{file_id[:12]}.ogg")

            with open(ogg_path, "wb") as f:
                f.write(resp.content)

            logger.info(
                "Voice downloaded | file_id=%s | size=%d bytes | path=%s",
                file_id[:12], len(resp.content), ogg_path,
            )

            # 3. Transcribir
            text = self._run_transcription(ogg_path)

            # 4. Limpiar archivo temporal
            try:
                os.unlink(ogg_path)
            except OSError:
                pass

            return text

        except Exception as exc:
            logger.error("Voice transcription failed: %s", exc)
            return None

    @staticmethod
    def _run_transcription(audio_path: str) -> Optional[str]:
        """
        Transcribe un archivo de audio a texto.

        Intenta en orden:
          1. OpenAI Whisper API (cloud, rápido, soporta .ogg directo)
          2. faster-whisper local
          3. vectrax.comm.voice.transcribe() (fallback general)
        """
        # --- 1. OpenAI Whisper API (soporta .ogg nativo) ---
        api_key = os.environ.get("OPENAI_API_KEY", "")
        if not api_key:
            try:
                from dotenv import load_dotenv
                from pathlib import Path
                env_file = Path(audio_path).resolve().parent.parent.parent / ".env"
                # Fallback: load from project .env
                for candidate in [
                    Path(__file__).resolve().parent.parent / ".env",
                    Path.home() / "Vectrax" / ".env",
                ]:
                    if candidate.exists():
                        load_dotenv(candidate, override=False)
                        break
                api_key = os.environ.get("OPENAI_API_KEY", "")
            except Exception:
                pass

        if api_key:
            try:
                import requests as _req
                with open(audio_path, "rb") as f:
                    resp = _req.post(
                        "https://api.openai.com/v1/audio/transcriptions",
                        headers={"Authorization": f"Bearer {api_key}"},
                        files={"file": (os.path.basename(audio_path), f, "audio/ogg")},
                        data={"model": "whisper-1", "language": "es"},
                        timeout=30,
                    )
                    resp.raise_for_status()
                    text = resp.json().get("text", "").strip()
                    if text:
                        logger.info("Voice transcribed via OpenAI Whisper | len=%d", len(text))
                        return text
            except Exception as exc:
                logger.warning("OpenAI Whisper failed: %s", exc)

        # --- 2. faster-whisper local ---
        try:
            from faster_whisper import WhisperModel
            model = WhisperModel("base", device="cpu", compute_type="int8")
            segments, _ = model.transcribe(audio_path, language="es")
            text = " ".join(seg.text.strip() for seg in segments)
            if text:
                logger.info("Voice transcribed via faster-whisper | len=%d", len(text))
                return text
        except ImportError:
            pass
        except Exception as exc:
            logger.warning("faster-whisper failed: %s", exc)

        # --- 3. Fallback: vectrax voice module ---
        try:
            from vectrax.comm.voice import transcribe
            text = transcribe(audio_path)
            if text:
                logger.info("Voice transcribed via vectrax.comm.voice | len=%d", len(text))
                return text
        except Exception as exc:
            logger.warning("vectrax.comm.voice fallback failed: %s", exc)

        return None

    # -- Procesamiento de mensajes ------------------------------------------

    def _process_update(self, update: Dict[str, Any]) -> None:
        """Procesa un update de Telegram y lo enruta al bus."""
        update_id = update.get("update_id", 0)
        message = update.get("message")
        if not message:
            return

        # Extraer datos del mensaje
        chat_id = message.get("chat", {}).get("id")
        text = message.get("text", "")
        user = message.get("from", {})
        user_id = str(user.get("id", "unknown"))
        username = user.get("username", "")
        first_name = user.get("first_name", "")

        if not chat_id:
            return

        # --- Capturar ubicación si el usuario la comparte ---
        location = message.get("location")
        if location:
            lat = location.get("latitude", 0)
            lng = location.get("longitude", 0)
            if lat and lng:
                try:
                    from vectrax.user_memory import store_user_location
                    store_user_location(f"tg:{user_id}", lat, lng)
                    self._send_message(
                        chat_id,
                        "✅ Ubicación recibida. Ahora puedo darte resultados cercanos.",
                        reply_markup={"remove_keyboard": True},
                    )
                except Exception as exc:
                    logger.warning("Failed to store location: %s", exc)
            if not text:
                return

        # --- Transcribir mensaje de voz ---
        voice = message.get("voice") or message.get("audio")
        if voice and not text:
            transcribed = self._transcribe_voice(voice)
            if transcribed:
                text = transcribed
                logger.info(
                    "Voice transcribed | from=%s | text=%s",
                    username or first_name or user_id, text[:80],
                )
            else:
                self._send_message(
                    chat_id,
                    "No pude transcribir el audio. Intenta de nuevo o escribe tu mensaje.",
                )
                return

        if not text:
            return

        display_name = username or first_name or user_id

        # --- Comando de aprobación de reglas ---
        _approve_match = re.match(
            r"^(?:aprobar|approve)\s+(RULE-\w+)", text.strip(), re.IGNORECASE,
        )
        if _approve_match:
            rule_id = _approve_match.group(1).upper()
            try:
                from core.learn.learned_rules import get_rules_store
                store = get_rules_store()
                if store.activate_rule(rule_id):
                    self._send_message(chat_id, f"✅ Regla {rule_id} activada.")
                    logger.info("Rule %s approved by %s", rule_id, display_name)
                else:
                    self._send_message(chat_id, f"Regla {rule_id} no encontrada.")
            except Exception as exc:
                self._send_message(chat_id, f"Error al aprobar: {exc}")
            return

        logger.info(
            "Message received | from=%s (id=%s) | text=%s",
            display_name, user_id, text[:80],
        )

        # Registrar en ledger
        ledger.record_event(
            action="telegram.message_received",
            category=ledger.EventCategory.PERCEPTION,
            risk_zone=ledger.RiskZone.GREEN,
            reason=f"Telegram message from {display_name}",
            details={
                "user_id": user_id,
                "username": username,
                "chat_id": chat_id,
                "text_length": len(text),
            },
        )

        # Enviar al ExternalGateway → Universal Bus
        result = self._gateway.receive_message(
            user_id=f"tg:{user_id}",
            content=text,
            channel="telegram",
        )
        logger.info(
            "Message processed | correlation=%s | processed=%s",
            result.event_id, result.processed,
        )

        # Extraer respuesta según origen
        tg_user_id = f"tg:{user_id}"
        if result.source == "memory":
            # Memoria soberana: respuesta directa sin procesamiento adicional
            response_text = result.response
        else:
            response_text = result.response.strip() if result.response else ""
        if not response_text:
            response_text = "Vectrax activo. ¿Qué necesitas?"

        # --- Si buscó un lugar: enviar mapa o pedir ubicación ---
        try:
            from vectrax.integrations.place_search import detect_place_intent
            from vectrax.user_memory import get_user_location
            if detect_place_intent(text):
                user_loc = get_user_location(tg_user_id)
                if user_loc:
                    # Tiene ubicación: buscar y enviar venues con mapa
                    try:
                        from vectrax.integrations.place_search import search_places
                        place_result = search_places(text, user_location=user_loc)
                        if place_result.get("found") and place_result.get("results"):
                            self._send_places_with_map(
                                chat_id, place_result["results"], max_venues=3,
                            )
                    except Exception as exc:
                        logger.debug("Map venue send failed: %s", exc)
                else:
                    self._request_location(chat_id)
        except Exception:
            pass

        sent = self._send_message(chat_id, response_text)

        if sent:
            logger.info(
                "Response sent | to=%s | length=%d",
                display_name, len(response_text),
            )
            # Almacenar en memoria del usuario
            try:
                from vectrax.user_memory import store_memory
                store_memory(tg_user_id, text, response_text)
            except Exception:
                pass
            # Registrar respuesta en ledger
            ledger.record_event(
                action="telegram.response_sent",
                category=ledger.EventCategory.ACTION,
                risk_zone=ledger.RiskZone.GREEN,
                reason=f"Response sent to {display_name}",
                details={
                    "user_id": user_id,
                    "chat_id": chat_id,
                    "response_length": len(response_text),
                    "correlation_id": result.event_id,
                },
            )
        else:
            logger.error("Failed to send response to %s", display_name)

        self._total_processed += 1

    def _safe_process(self, update: Dict[str, Any]) -> None:
        """Wrapper thread-safe para _process_update con timeout."""
        import signal as _sig
        update_id = update.get("update_id", 0)
        message = update.get("message", {})
        chat_id = message.get("chat", {}).get("id")

        try:
            self._process_update(update)
        except Exception as exc:
            logger.error("Error processing update %d: %s", update_id, exc)
            # Intentar enviar error al usuario
            if chat_id:
                try:
                    self._send_message(chat_id, "Hubo un error procesando tu mensaje. Intenta de nuevo.")
                except Exception:
                    pass

    # -- Loop principal -----------------------------------------------------

    def run(self) -> None:
        """Ejecuta el loop de long polling. Bloqueante."""
        self._running = True
        logger.info("Bot started — entering long polling loop")

        # Registrar inicio en ledger
        ledger.record_event(
            action="telegram.bot_started",
            category=ledger.EventCategory.ACTION,
            risk_zone=ledger.RiskZone.GREEN,
            reason="Telegram bot started with long polling",
        )

        while self._running:
            try:
                updates = self._get_updates()
                self._consecutive_errors = 0

                for update in updates:
                    update_id = update.get("update_id", 0)
                    # Avanzar offset ANTES de procesar (no reprocesar)
                    self._offset = update_id + 1
                    # Procesar en thread separado (no bloquea polling)
                    self._executor.submit(self._safe_process, update)

            except Exception as exc:
                self._consecutive_errors += 1
                logger.error(
                    "Polling error (%d/%d): %s",
                    self._consecutive_errors, MAX_CONSECUTIVE_ERRORS, exc,
                )
                if self._consecutive_errors >= MAX_CONSECUTIVE_ERRORS:
                    logger.critical(
                        "Too many consecutive errors — stopping bot"
                    )
                    self._running = False
                    break
                time.sleep(RETRY_DELAY)

        logger.info(
            "Bot stopped | total_processed=%d", self._total_processed,
        )

    def stop(self) -> None:
        """Detiene el loop de polling de forma limpia."""
        logger.info("Stop signal received — shutting down")
        self._running = False

    def stats(self) -> Dict[str, Any]:
        """Estadísticas del gateway de Telegram."""
        return {
            "running": self._running,
            "total_processed": self._total_processed,
            "current_offset": self._offset,
            "consecutive_errors": self._consecutive_errors,
            "gateway_stats": self._gateway.stats(),
        }


# ---------------------------------------------------------------------------
# Carga de configuración
# ---------------------------------------------------------------------------

def _load_token() -> str:
    """Carga TELEGRAM_BOT_TOKEN desde .env o variables de entorno."""
    # Buscar .env en la raíz del proyecto
    env_path = _PROJECT_ROOT / ".env"
    if env_path.exists():
        load_dotenv(env_path)
    token = os.environ.get("TELEGRAM_BOT_TOKEN", "")
    if not token:
        logger.error(
            "TELEGRAM_BOT_TOKEN no encontrado. "
            "Añádelo a .env o como variable de entorno."
        )
        sys.exit(1)
    return token


# ---------------------------------------------------------------------------
# Entry point: python3 -m vectrax.telegram_gateway
# ---------------------------------------------------------------------------

def main() -> None:
    """Punto de entrada para el gateway de Telegram."""
    logger.info("=== Vectrax Telegram Gateway ===")

    token = _load_token()
    bot = TelegramGateway(token)

    # Manejo limpio de señales
    def _handle_signal(signum: int, frame: Any) -> None:
        bot.stop()

    signal.signal(signal.SIGINT, _handle_signal)
    signal.signal(signal.SIGTERM, _handle_signal)

    bot.run()


if __name__ == "__main__":
    main()
